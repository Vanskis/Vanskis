<?xml version="1.0" encoding="utf-8"?>
<!-- The 4x1 home-screen widget (access/AskWidget.kt): a pill to type into, and a mic button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ask_widget_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/ask_widget_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="@string/ask_widget_hint"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_droplet"
            android:tint="@color/ask_widget_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/ask_widget_hint"
            android:textColor="@color/ask_widget_on_surface"
            android:textSize="16sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ask_widget_mic"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/ask_widget_mic_bg"
        android:contentDescription="@string/ask_widget_voice"
        android:padding="10dp"
        android:src="@drawable/ic_mic"
        android:tint="@color/ask_widget_on_accent" />
</LinearLayout>
